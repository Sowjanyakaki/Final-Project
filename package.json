{
  "name": "nextleap-property-scout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "scrape:listings": "tsx --env-file=.env scripts/scrape-listings.ts",
    "ingest:docs": "tsx --env-file=.env scripts/ingest-neighborhood-docs.ts",
    "eval:feasibility": "tsx --env-file=.env evals/feasibility.ts",
    "eval:edit-correctness": "tsx --env-file=.env evals/edit-correctness.ts",
    "eval:grounding": "tsx --env-file=.env evals/grounding.ts",
    "eval:all": "npm run eval:feasibility -- --fixture evals/fixtures/feasibility-pass.json && npm run eval:edit-correctness -- --fixture evals/fixtures/edit-correct.json && npm run eval:grounding -- --fixture evals/fixtures/grounding-fully-grounded.json"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.26",
    "@ai-sdk/mcp": "^2.0.29",
    "@xenova/transformers": "^2.17.2",
    "ai": "^7.0.58",
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.44.2",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.1",
    "jsdom": "^30.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
