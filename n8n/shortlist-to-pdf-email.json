        "jsCode": "function escapeHtml(value) { var s = value === null || value === undefined ? '' : String(value); return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;'); } const body = $input.first().json.body || $input.first().json; const shortlist = Array.isArray(body.shortlist) ? body.shortlist : []; const rows = shortlist.map((item) => '<tr><td>' + escapeHtml(item.societyName) + '</td><td>' + escapeHtml(item.locality) + '</td><td>' + escapeHtml(item.rent) + '</td><td>' + escapeHtml(item.bedrooms) + '</td><td>' + escapeHtml((item.amenities || []).join(', ')) + '</td><td>' + escapeHtml(item.sqft) + '</td></tr>').join(''); const html = '<html><body><h2>Your Property Shortlist</h2><table border=1 cellpadding=6 cellspacing=0><thead><tr><th>Society</th><th>Locality</th><th>Rent</th><th>Bedrooms</th><th>Amenities</th><th>Sqft</th></tr></thead><tbody>' + rows + '</tbody></table></body></html>'; return [{ json: { html, email: body.email, sessionId: body.sessionId } }];"
      },
